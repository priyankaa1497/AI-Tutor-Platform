DATABASE_URL="postgresql://postgres:password@127.0.0.1:5432/v2holoroid"
AUTH_SECRET="learnai-dev-secret-change-me"
APP_DEBUG=true
NEXT_PUBLIC_APP_NAME=LearnAI

# ==========================================
# Primary Core AI: Google Gemini
# Powers Learn Chat, Quiz Generation, Grading, Vision & Tune Lab
# ==========================================
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ==========================================
# Primary Voice AI: Sarvam AI
# Powers Indian English & Multilingual STT (Speech-to-Text) and TTS (Text-to-Speech)
# ==========================================
SARVAM_API_KEY=
# Optional: Fallback LLM / OpenAI (if Gemini is unset)
OPENAI_API_KEY=

# Optional: Azure OpenAI / Cognitive Services
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=LearnAI
AZURE_OPENAI_API_VERSION=
AZURE_SPEECH_TO_TEXT_ENDPOINT=
AZURE_SPEECH_TO_TEXT_API_KEY=
AZURE_TEXT_TO_SPEECH_ENDPOINT=
AZURE_TEXT_TO_SPEECH_API_KEY=

D_ID_API_KEY=
CLOUDINARY_URL=

# Optional SMTP. If unset, OTPs are logged to the server console and returned in debug JSON.
MAIL_FROM_ADDRESS=hello@learnai.local
MAIL_FROM_NAME=LearnAI
